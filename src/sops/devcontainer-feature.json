{
  "id": "sops",
  "version": "1.0.3",
  "name": "sops",
  "description": "Installs the sops secret editor as a single static binary.",
  "documentationURL": "https://github.com/hansehart/devcontainer-features/tree/main/src/sops",
  "options": {
    "version": {
      "type": "string",
      "default": "latest",
      "description": "Channel (latest) or an exact version (major.minor.patch)."
    },
    "stateDir": {
      "type": "string",
      "default": "",
      "description": "If set, puts this feature's data at this path. Mount a volume there to persist it across rebuilds."
    }
  },
  "dependsOn": {
    "ghcr.io/hansehart/devcontainer-features/age:1": {}
  },
  "postCreateCommand": "/usr/local/share/sops/init.sh"
}
