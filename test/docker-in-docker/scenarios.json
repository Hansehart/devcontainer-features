{
  "daemon_json": {
    "image": "ubuntu:24.04",
    "remoteUser": "ubuntu",
    "features": {
      "docker-in-docker": {
        "daemonJson": "{\\\"no-new-privileges\\\":true}"
      }
    }
  },
  "pinned_version": {
    "image": "ubuntu:24.04",
    "remoteUser": "ubuntu",
    "features": {
      "docker-in-docker": {
        "version": "28"
      }
    }
  },
  "rootless_daemon": {
    "image": "ubuntu:24.04",
    "remoteUser": "ubuntu",
    "runArgs": [
      "--security-opt",
      "apparmor=unconfined",
      "--security-opt",
      "seccomp=${localEnv:PWD}/src/docker-in-docker/seccomp.json",
      "--security-opt",
      "systempaths=unconfined",
      "--cap-drop",
      "MKNOD",
      "--cap-drop",
      "NET_RAW",
      "--cap-drop",
      "AUDIT_WRITE",
      "--device",
      "/dev/net/tun"
    ],
    "features": {
      "docker-in-docker": {}
    }
  },
  "shared_socket": {
    "image": "ubuntu:24.04",
    "remoteUser": "ubuntu",
    "runArgs": [
      "--security-opt",
      "apparmor=unconfined",
      "--security-opt",
      "seccomp=${localEnv:PWD}/src/docker-in-docker/seccomp.json",
      "--security-opt",
      "systempaths=unconfined",
      "--cap-drop",
      "MKNOD",
      "--cap-drop",
      "NET_RAW",
      "--cap-drop",
      "AUDIT_WRITE",
      "--device",
      "/dev/net/tun"
    ],
    "features": {
      "docker-in-docker": {}
    },
    "mounts": [
      {
        "source": "dind-shared-socket",
        "target": "/run/docker-host",
        "type": "volume"
      }
    ]
  }
}
