{
  "daemon_json": {
    "image": "ubuntu:24.04",
    "remoteUser": "ubuntu",
    "features": {
      "docker-in-docker": {
        "daemonJson": "{\\\"no-new-privileges\\\":true}"
      }
    }
  },
  "pinned_version": {
    "image": "ubuntu:24.04",
    "remoteUser": "ubuntu",
    "features": {
      "docker-in-docker": {
        "version": "28"
      }
    }
  },
  "rootless_daemon": {
    "image": "ubuntu:24.04",
    "remoteUser": "ubuntu",
    "runArgs": [
      "--security-opt",
      "apparmor=unconfined",
      "--security-opt",
      "seccomp=${localEnv:PWD}/test/docker-in-docker/seccomp.json",
      "--security-opt",
      "systempaths=unconfined",
      "--cap-drop",
      "MKNOD",
      "--cap-drop",
      "NET_RAW",
      "--cap-drop",
      "AUDIT_WRITE",
      "--device",
      "/dev/net/tun"
    ],
    "mounts": [
      {
        "source": "dind-rootless-data",
        "target": "/home/ubuntu/.local/share/docker",
        "type": "volume"
      }
    ],
    "features": {
      "docker-in-docker": {}
    }
  },
  "rootless_daemon_apparmor": {
    "image": "ubuntu:24.04",
    "remoteUser": "ubuntu",
    "runArgs": [
      "--security-opt",
      "apparmor=dind-rootless",
      "--security-opt",
      "seccomp=${localEnv:PWD}/test/docker-in-docker/seccomp.json",
      "--security-opt",
      "systempaths=unconfined",
      "--cap-drop",
      "MKNOD",
      "--cap-drop",
      "NET_RAW",
      "--cap-drop",
      "AUDIT_WRITE",
      "--device",
      "/dev/net/tun"
    ],
    "mounts": [
      {
        "source": "dind-rootless-apparmor-data",
        "target": "/home/ubuntu/.local/share/docker",
        "type": "volume"
      }
    ],
    "features": {
      "docker-in-docker": {}
    }
  }
}
