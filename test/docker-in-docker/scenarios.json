{
  "daemon_json": {
    "image": "ubuntu:24.04",
    "remoteUser": "ubuntu",
    "features": {
      "docker-in-docker": {
        "daemonJson": "{\\\"no-new-privileges\\\":true}"
      }
    }
  },
  "pinned_version": {
    "image": "ubuntu:24.04",
    "remoteUser": "ubuntu",
    "features": {
      "docker-in-docker": {
        "version": "28"
      }
    }
  },
  "rootless_daemon": {
    "image": "ubuntu:24.04",
    "remoteUser": "ubuntu",
    "runArgs": [
      "--security-opt",
      "apparmor=unconfined",
      "--security-opt",
      "seccomp=${localWorkspaceFolder}/seccomp.json"
    ],
    "features": {
      "docker-in-docker": {}
    }
  }
}
